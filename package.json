{
  "name": "bundle-management",
  "version": "1.0.0-beta.14",
  "description": "Bundle management",
  "author": "Nex3 Team",
  "main": "main.js",
  "types": "types/runtime-scripts/bundle-management.d.ts",
  "runtime-resource": {
    "path": "runtime-scripts",
    "name": "plugin"
  },
  "reload": {
    "ignore": [
      "runtime-scripts/**/*"
    ]
  },
  "files": [
    "docs/",
    "lib/",
    "scripts/",
    "src/",
    "types/"
  ],
  "scripts": {
    "postinstall": "node scripts/install-extension.js",
    "test": "jest",
    "test-coverage": "jest --coverage",
    "build": "rimraf ./lib && rimraf ./types && tsc && copyfiles -u 1 src/**/*.meta lib",
    "example:install": "node scripts/install-extension.js --debug",
    "reg": "npm set registry http://npm.lumigame.com",
    "semantic-release": "semantic-release",
    "version:patch": "npm version patch --git-tag-version false",
    "version:minor": "npm version minor --git-tag-version false",
    "version:beta": "npm version prerelease --git-tag-version false --preid beta",
    "publish:beta": "yarn version:beta && npm publish --registry http://npm.lumigame.com --tag beta"
  },
  "husky": {
    "hooks": {
      "pre-push": "yarn build && yarn test",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "jestSonar": {
    "reportPath": "reports",
    "reportFile": "test-reporter.xml",
    "indent": 4
  },
  "release": {
    "extends": [
      "sc-semantic-release"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "15.0.0",
    "@commitlint/config-conventional": "15.0.0",
    "@semantic-release/changelog": "5.0.1",
    "@semantic-release/commit-analyzer": "8.0.1",
    "@semantic-release/git": "9.0.1",
    "@semantic-release/gitlab": "6.2.2",
    "@semantic-release/npm": "7.1.3",
    "@semantic-release/release-notes-generator": "9.0.3",
    "@types/jest": "27.0.3",
    "copyfiles": "2.4.1",
    "fs-extra": "10.0.1",
    "husky": "7.0.4",
    "jest": "27.5.1",
    "jest-junit": "13.0.0",
    "jest-sonar-reporter": "2.0.0",
    "rimraf": "3.0.2",
    "sc-semantic-release": "1.2.0",
    "semantic-release": "17.4.7",
    "ts-jest": "27.1.3",
    "typescript": "4.5.5"
  }
}
