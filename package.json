{
  "name": "bundle-management",
  "version": "1.0.0",
  "description": "Bundle management",
  "author": "Nex3 Team",
  "main": "src/main.js",
  "runtime-resource": {
    "path": "src/runtime-scripts",
    "name": "plugin"
  },
  "reload": {
    "ignore": [
      "src/runtime-scripts/**/*"
    ]
  },
  "scripts": {
    "test": "jest",
    "test-coverage": "jest --coverage"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "jestSonar": {
    "reportPath": "reports",
    "reportFile": "test-reporter.xml",
    "indent": 4
  },
  "devDependencies": {
    "@commitlint/cli": "^15.0.0",
    "@commitlint/config-conventional": "^15.0.0",
    "husky": "^7.0.4",
    "jest": "^27.4.3",
    "jest-junit": "^13.0.0",
    "jest-sonar-reporter": "^2.0.0"
  }
}
