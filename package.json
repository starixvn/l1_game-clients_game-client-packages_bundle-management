{
  "name": "bundle-management",
  "version": "1.0.0",
  "description": "Bundle management",
  "author": "Nex3 Team",
  "main": "main.js",
  "runtime-resource": {
    "path": "runtime-scripts",
    "name": "plugin"
  },
  "reload": {
    "ignore": [
      "runtime-scripts/**/*"
    ]
  },
  "scripts": {
    "postinstall": "node scripts/install-extension.js",
    "test": "jest",
    "test-coverage": "jest --coverage",
    "build": "rimraf ./lib && tsc && copyfiles -u 1 src/**/*.meta lib",
    "example:install": "node scripts/install-extension.js --debug"
  },
  "husky": {
    "hooks": {
      "pre-push": "yarn build && yarn test",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "jestSonar": {
    "reportPath": "reports",
    "reportFile": "test-reporter.xml",
    "indent": 4
  },
  "devDependencies": {
    "@commitlint/cli": "^15.0.0",
    "@commitlint/config-conventional": "^15.0.0",
    "@types/jest": "^27.0.3",
    "copyfiles": "^2.4.1",
    "fs-extra": "^10.0.0",
    "husky": "^7.0.4",
    "jest": "^27.4.3",
    "jest-junit": "^13.0.0",
    "jest-sonar-reporter": "^2.0.0",
    "rimraf": "^3.0.2",
    "ts-jest": "^27.1.3",
    "typescript": "^4.5.5"
  }
}
